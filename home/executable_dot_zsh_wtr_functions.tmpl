{{- if .work -}}
#
# Waitrose
#
gcloud-sso() {
  if ! gcloud auth list --format="value(account)" --filter="status=ACTIVE" 2>/dev/null | grep -q .; then
    gcloud auth login
  fi
}

gcloud-pam() {
  gcloud_project=${1}
  local entitlement="projects/${gcloud_project}/{{ .gcloud_entitlement_suffix }}"

  if gcloud pam grants list \
      --entitlement="${entitlement}" \
      --location=global \
      --filter="state=ACTIVE OR state=ACTIVATING" \
      --format="value(name)" 2>/dev/null | grep -q .; then
    return 0
  fi

  gcloud pam grants create \
      --entitlement="${entitlement}" \
      --requested-duration="36000s" \
      --justification="Developing services" \
      --location=global
}

gcloud-k8s() {
  gcloud_env=${1:-flex}

  gcloud-sso

  gcloud_project=""
  gcloud_cluster_name=""
  gcloud_cluster_project=""
  case "${gcloud_env}" in
    "flex")
      gcloud_project="{{ .gcloud_flex_project }}"
      gcloud_cluster_name="{{ .gcloud_flex_cluster_name }}"
      gcloud_cluster_project="{{ .gcloud_flex_cluster_project }}"
      gcloud_cluster_region="{{ .gcloud_flex_cluster_region }}"
      ;;
    "prod")
      gcloud_project="{{ .gcloud_prod_project }}"
      gcloud_cluster_name="{{ .gcloud_prod_cluster_name }}"
      gcloud_cluster_project="{{ .gcloud_prod_cluster_project }}"
      gcloud_cluster_region="{{ .gcloud_prod_cluster_region }}"
      ;;
    *)
      gcloud_project="{{ .gcloud_flex_project }}"
      gcloud_cluster_name="{{ .gcloud_flex_cluster_name }}"
      gcloud_cluster_project="{{ .gcloud_flex_cluster_project }}"
      gcloud_cluster_region="{{ .gcloud_flex_cluster_region }}"
      ;;
  esac

  gcloud-pam ${gcloud_project}

  gcloud config set project ${gcloud_project}

  gcloud container clusters get-credentials ${gcloud_cluster_name} --region ${gcloud_cluster_region} --project ${gcloud_cluster_project}

  current_name=$(kubectx -c)

  kubectl config delete-context ${gcloud_project}
  kubectl config rename-context ${current_name} ${gcloud_project}
}

aws-sso() {
  aws_profile=${1:-nonprod}
  export AWS_PROFILE=${aws_profile}
  aws-sso-util login
  eval "$(aws configure export-credentials --profile ${aws_profile} --format env)"
}

aws-sso-by-env() {
    aws_env=${1:-dev}

    aws_profile=""
    case "${aws_env}" in
      "sandbox")
        aws_profile="sandbox"
        ;;
      "dev")
        aws_profile="nonprod"
        ;;
      "qa")
        aws_profile="nonprod"
        ;;
      "perf2")
        aws_profile="nonprod2"
        ;;
      "prod")
        aws_profile="prod"
        ;;
      *)
        aws_profile="nonprod"
        ;;
    esac

    aws-sso ${aws_profile}
}

unset-kube-ctx() {
    kubectl config unset current-context
}

aws-eks() {
    aws_eks_env=${1:-dev}

    if ! lsof -ti tcp:6443 > /dev/null 2>&1; then
        echo "❌ Error: EKS tunnel is not running. Start it first with: ssm-tunnel-eks ${aws_eks_env}"
        return 1
    fi

    aws-sso-by-env ${aws_eks_env}

    aws eks update-kubeconfig --name {{ .aws_eks_kubecontext }}

    cluster_name=$(kubectl config view -o jsonpath="{.contexts[?(@.name==\"$(kubectl config current-context)\")].context.cluster}")
    original_server=$(kubectl config view -o jsonpath="{.clusters[?(@.name==\"${cluster_name}\")].cluster.server}")
    eks_hostname=$(echo "${original_server}" | sed 's|https://||')
    kubectl config set-cluster "${cluster_name}" \
        --server="https://127.0.0.1:6443" \
        --tls-server-name="${eks_hostname}"

    current_name=$(kubectx -c)
    desired_name=$(echo ${current_name} | cut -d / -f2)

    kubectl config delete-context ${desired_name}
    kubectl config rename-context ${current_name} ${desired_name}
}

cfn_nag_scan() {
  docker run -ti --rm -v $(pwd):/apps -w /apps alpine/cfn-nag $@
}

aws-customer-db-auth() {
  dbname=${1}

  cluster_endpoint=$(aws rds describe-db-cluster-endpoints --filters "Name=db-cluster-endpoint-type,Values=READER" \
                    | jq -r '.DBClusterEndpoints[] | select(.Endpoint | contains("customer")) | .Endpoint')

  aws rds generate-db-auth-token \
      --hostname ${cluster_endpoint} \
      --port 5432 \
      --username ${dbname}-readonly \
      --region eu-west-1
}

ssm-tunnel-customer-db() {
    env=${1:-dev}

    aws-sso-by-env ${env}

    ssm-port-forward ${env} {{ .aws_customerdb_host }} 5432
}

ssm-tunnel-eks() {
    eks_env=${1:-dev}
    ssm_env=${eks_env}
    [[ "${eks_env}" == "ute" ]] && ssm_env="dev"

    aws-sso-by-env ${eks_env}

    eks_cluster="{{ .aws_eks_cluster_prefix }}-${eks_env}-eks"
    eks_endpoint=$(aws eks describe-cluster \
        --name "${eks_cluster}" \
        --query 'cluster.endpoint' \
        --output text | sed 's|https://||')

    if [ -z "${eks_endpoint}" ] || [ "${eks_endpoint}" = "None" ]; then
        echo "❌ Error: Could not find EKS cluster '${eks_cluster}'"
        return 1
    fi

    ssm-port-forward ${ssm_env} "${eks_endpoint}" 443 6443
}

ssm-get-instance-id() {
    env=${1:-dev}

    name_pattern="{{- .aws_ssmgateway_stack }}-${env}"

    aws ec2 describe-instances \
        --filters "Name=tag:Name,Values=${name_pattern}" \
                  "Name=instance-state-name,Values=running" \
        --query "Reservations[*].Instances[*].InstanceId" \
        --output text | awk '{print $1}'
}

ssm-port-forward() {
    env=${1:-dev}
    host=${2}
    port=${3}
    local_port=${4:-${port}}

    name_pattern="{{- .aws_ssmgateway_stack }}-${env}"

    echo "--------------------------------------------------------------"
    echo "🔐 SSM TUNNEL"
    echo "--------------------------------------------------------------"
    echo "You are establishing a secure tunnel via the SSM Gateway"
    echo "Environment: ${env}"
    echo "Local Access: localhost:${local_port}"
    echo "--------------------------------------------------------------"
    echo "Notes:"
    echo "- This session has a HARD LIMIT of 120 minutes"
    echo "- All activity is recorded and monitored for compliance"
    echo "- The tunnel is CONNECTED when you see the message:"
    echo "  Waiting for connections..."
    echo "--------------------------------------------------------------"
    echo "🔍 Searching for Bridge matching: ${name_pattern}"
    echo "🎯 Target Host: ${host}"

    instance_id=$(ssm-get-instance-id ${env})

    if [ -z "${instance_id}" ] || [ "${instance_id}" = "None" ]; then
        echo "❌ Error: No running bridge found for environment '${env}'"
        exit 1
    fi

    echo "✅ Bridge Found: ${instance_id}"
    echo "🚀 Opening Tunnel..."

    aws ssm start-session \
        --target "${instance_id}" \
        --document-name AWS-StartPortForwardingSessionToRemoteHost \
        --parameters "{
            \"host\":[\"${host}\"],
            \"portNumber\":[\"${port}\"],
            \"localPortNumber\":[\"${local_port}\"]
        }"
}

docker-localstack-logs() {
    docker logs -f $(docker ps -aqf "label=localstack")
}

docker-localstack-bash() {
    docker exec -it $(docker ps -aqf "label=localstack") /bin/bash
}
{{- end -}}
